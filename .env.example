# Copy this file to .env and adjust the values, then `docker compose up --build`.

# Postgres password (shared by the db and backend services)
DB_PASSWORD=compass-dev-pw

# JWT signing secret — use a long random string in any real deployment
APP_JWT_SECRET=change-me-to-a-long-random-string

# Groq API key (optional). Leave empty to use the built-in rule-based AI fallback.
GROQ_API_KEY=
